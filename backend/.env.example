# Entorno de ejecución: development, production o test.
ENVIRONMENT=development

# Conexión a PostgreSQL (driver asyncpg). En Docker Compose usa el nombre del servicio como host.
DATABASE_URL=postgresql+asyncpg://wabot:wabot@localhost:5432/wabot

# Clave que deben enviar los clientes en la cabecera X-API-Key (o ?key= en el WebSocket). Vacía = sin autenticación (solo desarrollo).
API_KEY=

# Orígenes permitidos por CORS, en formato JSON (la URL del panel web).
CORS_ORIGINS=["http://localhost:5173"]

# URL pública del backend; se usa para construir los enlaces de descarga de archivos.
PUBLIC_URL=http://localhost:8000

# Nombre del negocio; reemplaza {business_name} en config/prompt.md y config/knowledge.md.
BUSINESS_NAME=Impulso Digital

# Número de WhatsApp del negocio (formato E.164).
BUSINESS_PHONE=+51900000000

# Horas que dura la ventana de atención desde el último mensaje del cliente (regla de Meta: 24).
SERVICE_WINDOW_HOURS=24

# Pausa (ms) con indicador "escribiendo..." antes de que responda el bot.
TYPING_DELAY_MS=700

# Retraso (ms) con el que el simulador marca los mensajes como entregados y luego leídos.
SIMULATOR_ACK_DELAY_MS=600

# Carpeta donde se guardan los archivos subidos.
MEDIA_DIR=./data/media

# Tamaño máximo de subida en MB (los límites por tipo de Meta se aplican igual).
MAX_UPLOAD_MB=100

# Proveedor de IA: none, openrouter, openrouterperu, openai, ollama o custom.
AI_PROVIDER=none

# URL base compatible con OpenAI. Vacía = la del proveedor elegido; obligatoria con custom.
AI_BASE_URL=

# Clave del proveedor de IA (no hace falta con ollama).
AI_API_KEY=

# Modelo a usar. Ejemplos: openai/gpt-4o-mini (OpenRouter), gpt-4o-mini (OpenAI), llama3.1 (Ollama).
AI_MODEL=openai/gpt-4o-mini

# Modelo de respaldo del mismo proveedor si el principal falla o responde vacío. Vacío = sin respaldo.
AI_FALLBACK_MODEL=

# Segundos máximos de espera por respuesta de la IA (los modelos de razonamiento tardan más).
AI_TIMEOUT_SECONDS=45

# Creatividad de las respuestas (0 = precisas, 1 = creativas).
AI_TEMPERATURE=0.3

# Máximo de tokens por respuesta de la IA.
AI_MAX_TOKENS=600

# Cuántos mensajes previos de la conversación se envían como contexto a la IA.
AI_HISTORY_SIZE=16

# Ejemplo OpenRouter:
#   AI_PROVIDER=openrouter
#   AI_API_KEY=sk-or-v1-...
#   AI_MODEL=openai/gpt-4o-mini
# Ejemplo OpenRouter Perú (https://openrouterperu.teinor.dev/api/v1):
#   AI_PROVIDER=openrouterperu
#   AI_API_KEY=tu-clave
#   AI_MODEL=openai/gpt-4o-mini

# Carpeta con flow.json, prompt.md, knowledge.md, templates.json y assets/.
CONFIG_DIR=./config

# URL que recibe los eventos salientes (webhooks). Vacía = desactivado.
WEBHOOK_URL=

# Secreto para firmar los webhooks (cabecera X-Wabot-Signature: sha256=HMAC del cuerpo).
WEBHOOK_SECRET=

# Intentos máximos de entrega de cada webhook antes de marcarlo como fallido.
WEBHOOK_MAX_ATTEMPTS=6
